# Preserve LF for the Mac launcher's shebang after Windows checkouts.
*.command text eol=lf
# Retain verified upstream notice bytes/hashes, including original whitespace.
assets/vendor/alphatab/LICENSE text eol=lf -whitespace
assets/vendor/alphatab/LICENSE.header text eol=lf -whitespace
assets/vendor/alphatab/font/*.txt text eol=lf -whitespace
assets/vendor/alphatab/soundfont/LICENSE text eol=lf -whitespace
assets/vendor/alphatab/soundfont/README.md text eol=lf -whitespace
# Unified diff context prefixes precede the upstream source's tab indentation.
docs/licenses/alphaTab-note-tap.patch text eol=lf whitespace=-space-before-tab

# Preserve verified runtime bytes and upstream whitespace in source archives/checkouts.
assets/vendor/alphatab/*.js text eol=lf -whitespace
assets/vendor/alphatab/*.mjs text eol=lf -whitespace
assets/vendor/alphatab/font/Bravura.svg text eol=lf -whitespace
# Reapplicable vendor patches preserve upstream context and indentation.
docs/licenses/*.patch text eol=lf -whitespace
docs/licenses/alphatab-1.9.0/*.patch text eol=lf -whitespace
